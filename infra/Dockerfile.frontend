FROM node:20-alpine AS build

LABEL maintainer="UNED Activities Team"
LABEL version="0.10.1-alpha"
LABEL description="React frontend for UNED Activities Finder"

WORKDIR /app
COPY web/package.json web/package-lock.json ./web/
WORKDIR /app/web
RUN npm ci
COPY web/ /app/web

ARG VITE_API_URL
RUN if [ -z "$VITE_API_URL" ]; then \
      echo "ERROR: VITE_API_URL build arg required"; \
      exit 1; \
    fi

ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.25-alpine

LABEL maintainer="UNED Activities Team"
LABEL version="0.10.1-alpha"
LABEL description="React frontend for UNED Activities Finder (production)"

COPY infra/nginx-static.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/dist /usr/share/nginx/html

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1
