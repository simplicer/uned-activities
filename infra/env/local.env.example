# Application Environment
APP_ENV=local
APP_DEBUG=true
APP_VERSION=1.0.0-dev

# Database
DB_DSN=postgres://postgres:postgres@localhost:5432/uned_activities
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uned_activities
DB_USER=postgres
DB_PASSWORD=postgres

# Supabase GoTrue (Auth)
GOTRUE_URL=http://localhost:9999
JWT_SECRET=see-dokploy-panel

# GoTrue SMTP (Supabase magic links)
GOTRUE_SMTP_HOST=smtp.example.com
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=noreply@example.com
GOTRUE_SMTP_PASS=see-dokploy-panel
GOTRUE_SMTP_ADMIN_EMAIL=noreply@example.com
GOTRUE_SMTP_SENDER_NAME="Buscador UNED"

# GoTrue OAuth
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=
GOTRUE_EXTERNAL_AZURE_ENABLED=false
GOTRUE_EXTERNAL_AZURE_CLIENT_ID=
GOTRUE_EXTERNAL_AZURE_SECRET=
GOTRUE_EXTERNAL_AZURE_URL=
GOTRUE_EXTERNAL_AZURE_REDIRECT_URI=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTH=300

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=smtp-user@example.org
SMTP_PASSWORD=see-dokploy-panel
SMTP_FROM_EMAIL=smtp-user@example.org
SMTP_FROM_NAME="Buscador UNED"

# Logging
LOG_LEVEL=debug

# AI / Embeddings
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Set a free OpenRouter embeddings model when available, otherwise leave empty.
OPENROUTER_EMBEDDING_MODEL=
GEMINI_MODELS=gemini-3-flash-preview,gemini-2.5-flash
OPENROUTER_MODELS=arcee-ai/trinity-large-preview:free,arcee-ai/trinity-mini:free,nvidia/nemotron-3-nano-30b-a3b:free,openai/gpt-oss-20b:free
EMBEDDINGS_ENABLED=false

# Build info (for production)
GIT_COMMIT=unknown
BUILD_DATE=unknown
