# Application Environment
APP_ENV=local
APP_DEBUG=true
APP_VERSION=1.0.0-dev

# Database
DB_DSN=postgres://postgres:postgres@localhost:5432/uned_activities
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uned_activities
DB_USER=postgres
DB_PASSWORD=postgres

# Supabase GoTrue (Auth)
GOTRUE_URL=http://localhost:9999
JWT_SECRET=see-dokploy-panel

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTH=300

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=smtp-user@example.org
SMTP_PASSWORD=see-dokploy-panel
SMTP_FROM_EMAIL=smtp-user@example.org
SMTP_FROM_NAME="Buscador UNED"

# Logging
LOG_LEVEL=debug

# AI / Embeddings
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDINGS_ENABLED=true

# Build info (for production)
GIT_COMMIT=unknown
BUILD_DATE=unknown
