# Application Environment
APP_ENV=local
APP_DEBUG=true
APP_VERSION=1.0.0-dev

# Database
DB_DSN=postgres://postgres:postgres@localhost:5432/uned_activities
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uned_activities
DB_USER=postgres
DB_PASSWORD=postgres

# Supabase GoTrue (Auth)
GOTRUE_URL=http://localhost:9999
JWT_SECRET=see-dokploy-panel

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTH=300

# Frontend
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug

# Build info (for production)
GIT_COMMIT=unknown
BUILD_DATE=unknown
