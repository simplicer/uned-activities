# Application Environment
APP_ENV=local
APP_DEBUG=true
APP_VERSION=1.0.0

# Database
DB_DSN=postgres://postgres:postgres@localhost:5432/uned_activities
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uned_activities
DB_USER=postgres
DB_PASSWORD=postgres

# Auth / JWT
JWT_SECRET=see-dokploy-panel
JWT_TTL_SECONDS=3600
SUPABASE_JWT_ISSUER=supabase
SUPABASE_JWT_AUDIENCE=authenticated

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTH=300

# Frontend
FRONTEND_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=noreply@example.com
SMTP_PASSWORD=see-dokploy-panel
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="Lexemas"
CONTACT_EMAIL=hola@example.com

# Logging
LOG_LEVEL=debug

# AI / Embeddings
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Set a free OpenRouter embeddings model when available, otherwise leave empty.
OPENROUTER_EMBEDDING_MODEL=
GEMINI_MODELS=gemini-3-flash-preview,gemini-2.5-flash
OPENROUTER_MODELS=arcee-ai/trinity-large-preview:free,arcee-ai/trinity-mini:free,nvidia/nemotron-3-nano-30b-a3b:free,openai/gpt-oss-20b:free
EMBEDDINGS_ENABLED=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Rate limiter legacy (compat)
RATE_LIMIT=100
RATE_WINDOW=60

# Harvest
HARVEST_MAX_PAGES=50
HARVEST_INTERVAL_SECONDS=604800

# UNED URLs
UNED_BASE_URL=https://www.uned.es/cursos
UNED_INDEX_URL=https://extension.uned.es/

# Build info (for production)
GIT_COMMIT=unknown
BUILD_DATE=unknown
