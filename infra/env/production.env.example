# Production env example (Dokploy / Swarm)
# This file is meant to be pasted into Dokploy "Environment" for the stack.
# It avoids localhost and uses Swarm DNS names (tasks.*).

# ============================================================================
# APPLICATION
# ============================================================================
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0

# ============================================================================
# DATABASE (PostgreSQL on Swarm overlay)
# ============================================================================
# NOTE: The app uses DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD for PDO.
DB_DSN=postgres://postgres:${DB_PASSWORD}@tasks.db:5432/uned_activities
DB_HOST=tasks.db
DB_PORT=5432
DB_NAME=uned_activities
DB_USER=postgres
DB_PASSWORD=see-dokploy-panel

# ============================================================================
# AUTH / JWT
# ============================================================================
JWT_SECRET=see-dokploy-panel
JWT_TTL_SECONDS=3600
JWT_ISSUER=your-issuer
JWT_AUDIENCE=your-audience

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT=100
RATE_WINDOW=60

# ============================================================================
# FRONTEND / CORS
# ============================================================================
FRONTEND_URL=https://lexemas.com
CORS_ALLOWED_ORIGINS=https://lexemas.com,https://www.lexemas.com,https://api.lexemas.com

# ============================================================================
# SMTP
# ============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=noreply@example.com
SMTP_PASSWORD=see-dokploy-panel
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="UNED Activities Finder"

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================================================
# AI / EMBEDDINGS (optional)
# ============================================================================
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Set a free OpenRouter embeddings model when available, otherwise leave empty.
OPENROUTER_EMBEDDING_MODEL=
GEMINI_MODELS=gemini-3-flash-preview,gemini-2.5-flash
OPENROUTER_MODELS=arcee-ai/trinity-large-preview:free,arcee-ai/trinity-mini:free,nvidia/nemotron-3-nano-30b-a3b:free,openai/gpt-oss-20b:free
EMBEDDINGS_ENABLED=false

# ============================================================================
# REDIS
# ============================================================================
REDIS_HOST=tasks.redis
REDIS_PORT=6379

# ============================================================================
# HARVEST
# ============================================================================
HARVEST_MAX_PAGES=50
HARVEST_INTERVAL_SECONDS=604800

# ============================================================================
# UNED URLs
# ============================================================================
UNED_BASE_URL=https://www.uned.es/cursos
UNED_INDEX_URL=https://extension.uned.es/

# ============================================================================
# BUILD INFO (optional)
# ============================================================================
GIT_COMMIT=unknown
BUILD_DATE=unknown
