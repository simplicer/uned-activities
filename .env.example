# Environment configuration for UNED Activities Finder
# Copy this file to .env and configure with your actual values
# NEVER commit .env files with real credentials to version control

# ============================================================================
# APPLICATION
# ============================================================================
APP_ENV=local
APP_DEBUG=true
APP_VERSION=1.0.0-dev

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DB_DSN=postgres://postgres:YOUR_PASSWORD@localhost:5433/uned_activities

# Database connection details (for PDO)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=uned_activities
DB_USER=postgres
DB_PASSWORD=SEE_DOKPLOY_PANEL

# ============================================================================
# SUPABASE AUTH / JWT
# ============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET=SEE_DOKPLOY_PANEL
SUPABASE_JWT_ISSUER=supabase
SUPABASE_JWT_AUDIENCE=authenticated
JWT_TTL_SECONDS=3600

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT=100
RATE_WINDOW=60

# ============================================================================
# REDIS (Optional)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=SEE_DOKPLOY_PANEL

# ============================================================================
# FRONTEND
# ============================================================================
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ============================================================================
# UNED WEBSITE SCRAPING
# ============================================================================
UNED_BASE_URL=https://www.uned.es/cursos
UNED_INDEX_URL=https://extension.uned.es/

# ============================================================================
# NOTIFICATIONS / SMTP
# ============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=see-dokploy-panel
SMTP_PASSWORD=SEE_DOKPLOY_PANEL
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="UNED Finder"

# ============================================================================
# GOTRUE / SUPABASE AUTH (Optional)
# ============================================================================
GOTRUE_SMTP_HOST=smtp.example.com
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=see-dokploy-panel
GOTRUE_SMTP_PASS=SEE_DOKPLOY_PANEL
GOTRUE_SMTP_ADMIN_EMAIL=admin@example.com
GOTRUE_SMTP_SENDER_NAME="UNED Finder"

GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=
GOTRUE_EXTERNAL_AZURE_ENABLED=false
GOTRUE_EXTERNAL_AZURE_CLIENT_ID=
GOTRUE_EXTERNAL_AZURE_SECRET=
GOTRUE_EXTERNAL_AZURE_URL=
GOTRUE_EXTERNAL_AZURE_REDIRECT_URI=

MAGIC_LINK_EXPIRE_MINUTES=15

# ============================================================================
# AI API KEYS (Optional)
# ============================================================================
GEMINI_API_KEY=SEE_DOKPLOY_PANEL
OPENROUTER_API_KEY=SEE_DOKPLOY_PANEL
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENROUTER_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
GEMINI_MODELS=gemini-3-flash-preview,gemini-2.5-flash
OPENROUTER_MODELS=arcee-ai/trinity-large-preview:free,arcee-ai/trinity-mini:free
EMBEDDINGS_ENABLED=false


# Security Notes:
# 1. Never commit .env files with real credentials
# 2. Rotate all exposed secrets immediately after finding them in version control
# 3. Generate JWT_SECRET with: openssl rand -hex 32
# 4. Use App Passwords for Gmail SMTP, not account passwords
# 5. Keep API keys for AI services secure and rotate if exposed

