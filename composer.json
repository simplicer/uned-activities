{
    "name": "uned/activities-finder",
    "description": "UNED Extension Activities Finder - Monorepo",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.0",
        "guzzlehttp/guzzle": "^7.8",
        "ramsey/uuid": "^4.7",
        "symfony/uid": "^7.0",
        "doctrine/dbal": "^4.0",
        "firebase/php-jwt": "^6.10",
        "monolog/monolog": "^3.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-strict-rules": "^1.5",
        "squizlabs/php_codesniffer": "^3.8",
        "friendsofphp/php-cs-fixer": "^3.49",
        "rector/rector": "^1.0",
        "mockery/mockery": "^1.6",
        "phpspec/prophecy-phpunit": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "CatalogHarvest\\": "src/CatalogHarvest/",
            "CatalogQuery\\": "src/CatalogQuery/",
            "UserPreferences\\": "src/UserPreferences/",
            "Notifications\\": "src/Notifications/",
            "Shared\\": "src/Shared/",
            "HttpApi\\": "apps/HttpApi/",
            "CliJobs\\": "apps/CliJobs/",
            "Bootstrap\\": "apps/Bootstrap/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": [
            "@phpunit",
            "@phpstan --no-progress"
        ],
        "phpunit": "phpunit --colors=always",
        "phpunit-coverage": "phpunit --coverage-html coverage",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "rector": "rector process --dry-run",
        "rector-fix": "rector process",
        "audit": "composer audit --no-dev",
        "quality": [
            "@cs-check",
            "@phpstan",
            "@rector"
        ]
    }
}
