ARG APP_VERSION=1.0.0
ARG BUILD_DATE=unknown
ARG VCS_REF=unknown

# Multi-stage build for optimized frontend image
FROM node:20-alpine AS build

ARG APP_VERSION
ARG BUILD_DATE
ARG VCS_REF

LABEL maintainer="Simplicer" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.description="React frontend for UNED Activities Finder"

WORKDIR /app

# Copy dependency files first for better caching
COPY web/package*.json ./web/

# Install dependencies with npm ci (cleaner install)
WORKDIR /app/web
RUN npm ci --ignore-scripts --prefer-offline --no-audit

# Copy source files
COPY web/ /app/web/

# Build with validation
ARG VITE_API_URL
RUN if [ -z "$VITE_API_URL" ]; then \
      echo "ERROR: VITE_API_URL build arg required"; \
      exit 1; \
    fi

ENV VITE_API_URL=$VITE_API_URL
ENV NODE_ENV=production
RUN npm run build && rm -rf /root/.npm /app/web/node_modules

# Production stage - static server (QA/testing only)
FROM nginx:1.27-alpine

ARG APP_VERSION
ARG BUILD_DATE
ARG VCS_REF

LABEL maintainer="Simplicer" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.description="React frontend for UNED Activities Finder (production)"

# Copy nginx config
COPY infra/nginx-static.conf /etc/nginx/conf.d/default.conf

# Copy built assets from build stage
COPY --from=build --chown=nginx:nginx /app/web/dist /usr/share/nginx/html

# Security hardening
RUN rm -rf /var/cache/nginx/* && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    chown -R nginx:nginx /etc/nginx && \
    touch /var/run/nginx.pid && \
    chown nginx:nginx /var/run/nginx.pid

USER nginx

EXPOSE 80
