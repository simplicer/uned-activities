# Multi-stage build for optimized frontend image
FROM node:20-alpine AS build

LABEL maintainer="UNED Activities Team"
LABEL version="0.19.0-alpha"
LABEL description="React frontend for UNED Activities Finder"

WORKDIR /app

# Copy dependency files first for better caching
COPY web/package*.json ./web/

# Install dependencies with npm ci (cleaner install)
WORKDIR /app/web
RUN npm ci --ignore-scripts --prefer-offline --no-audit

# Copy source files
COPY web/ /app/web/

# Build with validation
ARG VITE_API_URL
RUN if [ -z "$VITE_API_URL" ]; then \
      echo "ERROR: VITE_API_URL build arg required"; \
      exit 1; \
    fi

ENV VITE_API_URL=$VITE_API_URL
ENV NODE_ENV=production
RUN npm run build && \
    # Remove cache after build
    rm -rf /root/.npm /app/web/node_modules

# Production stage - minimal nginx image
FROM nginx:1.27-alpine

LABEL maintainer="UNED Activities Team"
LABEL version="0.19.0-alpha"
LABEL description="React frontend for UNED Activities Finder (production)"

# Copy nginx config
COPY infra/nginx-static.conf /etc/nginx/conf.d/default.conf

# Copy built assets from build stage
COPY --from=build --chown=nginx:nginx /app/web/dist /usr/share/nginx/html

# Remove default nginx assets
RUN rm -rf /usr/share/nginx/html/*.html /usr/share/nginx/html/*.png

# Security hardening
RUN rm -rf /etc/nginx/conf.d/default.conf /var/cache/nginx/* && \
    addgroup -g 1000 -S nginx && \
    adduser -S -D -H -u 1000 -h /usr/share/nginx/html -s /sbin/nologin -G nginx -g nginx nginx && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    chown -R nginx:nginx /etc/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

USER nginx

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

EXPOSE 80
