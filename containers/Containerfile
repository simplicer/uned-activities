ARG APP_VERSION=1.0.0
ARG BUILD_DATE=unknown
ARG VCS_REF=unknown
ARG VITE_API_URL=https://api.lexemas.com
ARG VITE_API_PREFIX=/v1

# Multi-stage build for a small unified runtime image.
FROM composer:2 AS composer

FROM node:20-alpine AS frontend-build

ARG VITE_API_URL
ARG VITE_API_PREFIX

WORKDIR /app

COPY web/package*.json ./web/
WORKDIR /app/web
RUN npm ci --ignore-scripts --prefer-offline --no-audit

COPY web/ /app/web/
ENV NODE_ENV=production
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_API_PREFIX=${VITE_API_PREFIX}
RUN npm run build && rm -rf /root/.npm /app/web/node_modules

FROM php:8.4-fpm-alpine AS builder

ARG APP_VERSION
ARG BUILD_DATE
ARG VCS_REF

LABEL maintainer="Simplicer" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.description="UNED activities unified app image"

# Install build dependencies and PHP extensions in one layer
RUN apk add --no-cache --virtual .build-deps \
    $PHPIZE_DEPS \
    postgresql-dev \
    libzip-dev \
    && apk add --no-cache \
    git \
    zip \
    unzip \
    && pecl install redis \
    && docker-php-ext-install pdo pdo_pgsql zip opcache \
    && docker-php-ext-enable redis opcache \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy composer from composer image
COPY --from=composer /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Copy dependency files first for better caching
COPY composer.json composer.lock ./

# Install dependencies (production) without generating autoload yet.
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-autoloader \
    --no-progress \
    --prefer-dist \
    --no-interaction \
    && rm -rf /root/.composer/cache

# Copy application files
COPY --chown=1000:1000 . .
COPY --from=frontend-build --chown=1000:1000 /app/web/dist /app/apps/HttpApi/public/dist

# Build authoritative autoloader with the full source already copied.
RUN composer dump-autoload --optimize --classmap-authoritative --no-dev --no-interaction

# Final stage - minimal image
FROM php:8.4-fpm-alpine

ARG APP_VERSION
ARG BUILD_DATE
ARG VCS_REF

LABEL maintainer="Simplicer" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.description="UNED activities unified app image"

# Install only runtime dependencies
RUN apk add --no-cache \
    libpq \
    libzip \
    && rm -rf /var/cache/apk/*

# Copy PHP extensions from builder
COPY --from=builder --chown=1000:1000 /usr/local/etc/php/conf.d /usr/local/etc/php/conf.d
COPY --from=builder --chown=1000:1000 /usr/local/lib/php/extensions /usr/local/lib/php/extensions

# Copy application with vendor from builder
COPY --from=builder --chown=1000:1000 /app /app

WORKDIR /app

# Create non-root user
RUN addgroup -g 1000 php && \
    adduser -D -u 1000 -G php php && \
    mkdir -p /data/logs /data/harvest && \
    chown -R php:php /app /data

# PHP-FPM configuration for production
RUN echo "pm.max_children = 50" >> /usr/local/etc/php-fpm.conf && \
    echo "pm.start_servers = 5" >> /usr/local/etc/php-fpm.conf && \
    echo "pm.min_spare_servers = 5" >> /usr/local/etc/php-fpm.conf && \
    echo "pm.max_spare_servers = 35" >> /usr/local/etc/php-fpm.conf && \
    echo "pm.max_requests = 500" >> /usr/local/etc/php-fpm.conf && \
    echo "clear_env = no" >> /usr/local/etc/php-fpm.conf

USER php

EXPOSE 9000

HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD php -r "exit((int)(!file_exists('/app/apps/HttpApi/public/index.php')));"
